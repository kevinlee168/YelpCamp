<% layout('campgrounds/layouts/boilerplate') %>
<div class="col-8 offset-2">

    <img src="<%= campground.image %>" class="card-img-top" alt="...">
    <div class="card-body">
        <h5 class="card-title"><%= campground.title %> </h5>
        <p class="card-text"><small class="text-muted">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-person-circle" viewBox="0 0 16 16">
                <path d="M11 6a3 3 0 1 1-6 0 3 3 0 0 1 6 0z"/>
                <path fill-rule="evenodd" d="M0 8a8 8 0 1 1 16 0A8 8 0 0 1 0 8zm8-7a7 7 0 0 0-5.468 11.37C3.242 11.226 4.805 10 8 10s4.757 1.225 5.468 2.37A7 7 0 0 0 8 1z"/>
              </svg>
              <%= campground.author.username %></p>
            </small>
        </p>
        <p class="card-text"><%= campground.description %></p>
        <p class="card-text"><small class="text-muted">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor"
                    class="bi bi-currency-dollar" viewBox="0 0 16 16">
                    <path
                        d="M4 10.781c.148 1.667 1.513 2.85 3.591 3.003V15h1.043v-1.216c2.27-.179 3.678-1.438 3.678-3.3 0-1.59-.947-2.51-2.956-3.028l-.722-.187V3.467c1.122.11 1.879.714 2.07 1.616h1.47c-.166-1.6-1.54-2.748-3.54-2.875V1H7.591v1.233c-1.939.23-3.27 1.472-3.27 3.156 0 1.454.966 2.483 2.661 2.917l.61.162v4.031c-1.149-.17-1.94-.8-2.131-1.718H4zm3.391-3.836c-1.043-.263-1.6-.825-1.6-1.616 0-.944.704-1.641 1.8-1.828v3.495l-.2-.05zm1.591 1.872c1.287.323 1.852.859 1.852 1.769 0 1.097-.826 1.828-2.2 1.939V8.73l.348.086z" />
                </svg>
                <% if (campground.price === 0) { %>
                -
                <% } else { %>
                <%= campground.price; %> per night</small></p>
        <% } %>
        <p class="card-text"><small class="text-muted">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor"
                    class="bi bi-pin-map-fill" viewBox="0 0 16 16">
                    <path fill-rule="evenodd"
                        d="M3.1 11.2a.5.5 0 0 1 .4-.2H6a.5.5 0 0 1 0 1H3.75L1.5 15h13l-2.25-3H10a.5.5 0 0 1 0-1h2.5a.5.5 0 0 1 .4.2l3 4a.5.5 0 0 1-.4.8H.5a.5.5 0 0 1-.4-.8l3-4z" />
                    <path fill-rule="evenodd"
                        d="M4 4a4 4 0 1 1 4.5 3.969V13.5a.5.5 0 0 1-1 0V7.97A4 4 0 0 1 4 3.999z" />
                </svg>
                <%= campground.location %></small></p>
        <% if (user && user._id.equals(campground.author._id)) { %>
        <a class="card-link btn btn-dark" href="/campgrounds/<%= campground._id %>/edit"> Edit </a>
        <form class="d-inline" action="/campgrounds/<%= campground._id %>?_method=DELETE" method="POST">
            <button class="btn btn-warning" onclick="del()">Delete</button>
        </form>
        <% }%>

        <% if (user) { %>
        <h5 class="mt-3">Leave a Reivew</h5>
        <form class="form-validation" action="/campgrounds/<%= campground._id %>/reviews" method="POST" novalidate>
            <div class="mb-3">
                <label for="rating" class="form-label">Rating</label>
                <input type="range" class="form-range" min="0" max="5" id="rating" name="review[rating]">
            </div>
            <div class="mb-3">
                <label for="body" class="form-label"> Review</label>
                <textarea class="form-control" name="review[body]" id="body" cols="20" rows="3" required></textarea>
                <div class="valid-feedback">Looks Good!</div>
            </div>
            <button class="btn btn-success">Submit</button>
        </form>
    <% } %> 
        <% if (campground.reviews.length) { %>
        <div class="mt-3">
            <h5>Reviews</h5>

            <% for( let review of campground.reviews ) { %>
            <div class="card mb-3">
                <div class="mb-3 card-body"">
                        <div class=" card-title">
                    <p class="d-inline">Rating: <%= review.rating %></p>
                    <form class="d-inline float-right"
                        action="/campgrounds/<%= campground._id %>/reviews/<%= review._id %>?_method=DELETE"
                        method="POST">
                        <button class="btn btn-link" onclick="del()">Delete</button>
                    </form>
                </div>
                <p class="card-text"><%= review.body %></p>
            </div>
        </div>
        <% } %>
    </div>
    <% } %>
</div>

</div>