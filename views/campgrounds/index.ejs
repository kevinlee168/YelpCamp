<% layout('campgrounds/layouts/boilerplate') %>

  <div id="map" style="width: 100%; height: 400px; margin-bottom: 30px;"></div>

  <div class="row row-cols-1 row-cols-md-3 g-4">
    <% for( let camp of campgrounds.reverse() ) { %>
      <div class="col">
        <div class="card h-100">
          <% if (camp.images.length> 0) { %>
            <a href="/campgrounds/<%= camp._id %>"><img src="<%= camp.images[0].thumbnail %> " class="card-img-top"
                alt="..."></a>
            <% } else { %>
              <a href="/campgrounds/<%= camp._id %>"><img
                  src="https://res.cloudinary.com/daxhp4sga/image/upload/w_414,h_275/v1669559477/YelpCamp/nrjyqw2tedg0xvurzr00.jpg"
                  class="card-img-top" alt="..."></a>
              <% } %>
                <div class="card-body">
                  <h5 class="card-title"><a href="/campgrounds/<%= camp._id %>"> <%= camp.title %></a></h5>
                  <p class="card-text">
                    <%= camp.description %>
                  </p>
                </div>
                <div class="card-footer">
                  <small class="text-muted">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor"
                      class="bi bi-pin-map-fill" viewBox="0 0 16 16">
                      <path fill-rule="evenodd"
                        d="M3.1 11.2a.5.5 0 0 1 .4-.2H6a.5.5 0 0 1 0 1H3.75L1.5 15h13l-2.25-3H10a.5.5 0 0 1 0-1h2.5a.5.5 0 0 1 .4.2l3 4a.5.5 0 0 1-.4.8H.5a.5.5 0 0 1-.4-.8l3-4z" />
                      <path fill-rule="evenodd"
                        d="M4 4a4 4 0 1 1 4.5 3.969V13.5a.5.5 0 0 1-1 0V7.97A4 4 0 0 1 4 3.999z" />
                    </svg>
                    <%= camp.location %>
                  </small>
                </div>
        </div>
      </div>
      <% } %>
  </div>
  <script>
    const mapToken = '<%- process.env.MAPBOX_TOKEN %>';
    const campgrounds = {features: <%- JSON.stringify(campgrounds) %>};
    console.log(campgrounds);
  </script>
  <script src='https://api.mapbox.com/mapbox-gl-js/v3.6.0/mapbox-gl.js'></script>
  <script src="/js/clusterMap.js"></script>
